NODE_ENV=development
PORT=3000
JWT_SECRET=urban-cart-secret-key-super-secure-laragon-2026
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173

# Laragon MySQL Database Configuration
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urban_cart

# SQLite Fallback (if Laragon is not running)
DATABASE_PATH=./data/urban-cart.sqlite

# Optional one-time bootstrap for the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Urban Cart Admin

# Configure Stripe/Paymob adapter credentials here before enabling live card payments.
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
